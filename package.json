{
  "name": "redkido-consultancy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "node scripts/db-server.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:local": "node scripts/db-local.mjs",
    "db:reset:local": "node -e \"require('fs').rmSync('.pglite',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@react-three/fiber": "^9.7.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.11",
    "lenis": "^1.3.26",
    "motion": "^13.2.0",
    "next": "16.3.1",
    "pg": "^8.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.0.1",
    "three": "^0.185.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@electric-sql/pglite-socket": "^0.0.14",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "dotenv": "^17.0.0",
    "prisma": "^7.9.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
