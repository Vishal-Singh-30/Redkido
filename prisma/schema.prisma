// Prisma 7: no `url` here. The connection string comes from the driver adapter
// configured in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadKind {
  /// Someone used a contact form. No slot, no meeting.
  ENQUIRY
  /// Someone booked a call. Has exactly one Booking.
  CALL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum SlotStatus {
  /// Published by an admin and open for booking.
  AVAILABLE
  BOOKED
  /// Published but deliberately closed — holiday, admin is away.
  BLOCKED
}

enum BookingStatus {
  /// Calls are free, so a booking is confirmed the moment it is made. There is
  /// no pending state because there is no payment to wait for.
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

/// A bookable session. Admins create these from /admin/sessions; a visitor picks
/// a date and sees that date's AVAILABLE sessions.
///
/// This is the whole product now — there is no catalogue of paid consultation
/// types, no price and no duration to choose. A session IS a start and an end.
model Slot {
  id       String     @id @default(cuid())
  startsAt DateTime
  endsAt   DateTime
  status   SlotStatus @default(AVAILABLE)

  /// Optional label shown to the visitor, e.g. "Intro call". Purely cosmetic.
  label String?

  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// One session per start time. Stops an admin double-publishing the same slot.
  @@unique([startsAt])
  @@index([status, startsAt])
}

/// Everyone who reached out, from either funnel. This is the admin's list.
model Lead {
  id        String     @id @default(cuid())
  kind      LeadKind
  status    LeadStatus @default(NEW)
  name      String
  email     String
  phone     String?
  company   String?
  message   String?
  source    String?
  notes     String?
  booking   Booking?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([kind, createdAt])
  @@index([status])
  @@index([email])
}

/// A booked call. No money anywhere in this model.
model Booking {
  id     String        @id @default(cuid())
  leadId String        @unique
  lead   Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  slotId String
  slot   Slot          @relation(fields: [slotId], references: [id])
  status BookingStatus @default(CONFIRMED)

  /// Google Calendar event carrying the Meet conference. Claimed once via
  /// UPDATE ... WHERE "googleEventId" IS NULL so a retry cannot create two.
  googleEventId String?
  meetingUrl    String?

  /// Each claimed exactly once with UPDATE ... WHERE <col> IS NULL.
  confirmationEmailSentAt DateTime?
  reminderEmailSentAt     DateTime?
  ownerAlertSentAt        DateTime?

  rescheduleCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([slotId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
