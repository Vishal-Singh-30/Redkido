# ---------------------------------------------------------------------------
# Redkido Consultancy — environment template
#
# Copy to .env.local for local development. Values marked "Vercel: NO" must
# NEVER be added to the hosted project.
#
# Load order matters: prisma/env.ts loads .env.local BEFORE .env, because
# dotenv keeps the FIRST value it sees for a key. Reversing it makes a
# placeholder DATABASE_URL win silently.
# ---------------------------------------------------------------------------


# --- Database --------------------------------------------------------------

# Postgres connection string.
#   Local  : the PGlite server started by `npm run db:up`
#            postgresql://postgres:postgres@127.0.0.1:5433/postgres
#            Use 127.0.0.1, NOT localhost — PGlite binds IPv4 only and on
#            Windows "localhost" resolves to ::1 first, giving Prisma P1001.
#   Vercel : Supabase -> Project Settings -> Database -> Connection string.
#            Use the TRANSACTION pooler, port 6543, for the running app.
#   Migrations: ALWAYS the SESSION pooler, port 5432 — locally and in CI.
#            The transaction pooler (6543) does not support the prepared
#            statements and advisory locks `prisma migrate` needs, and it
#            fails in ways that do not name the port as the cause.
# Vercel: YES (6543)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"

# Maximum connections in the pg pool. MUST be 1 — this is a correctness
# setting, not tuning:
#   - PGlite serves exactly one connection and hangs on a second.
#   - On Vercel every lambda instance holds its own pool, so any value above 1
#     multiplies across instances and exhausts the Supabase pooler under load.
# Vercel: YES (also 1)
DATABASE_POOL_MAX=1


# --- Auth ------------------------------------------------------------------

# Signing key for the admin session JWT (jose, HS256).
# Generate with:  openssl rand -base64 32
# Rotating it logs every admin out. Never reuse the value between environments.
# Vercel: YES
AUTH_SECRET=""


# --- Razorpay --------------------------------------------------------------

# Razorpay Dashboard -> Account & Settings -> API Keys -> Generate Key.
# Test keys start with rzp_test_, live keys with rzp_live_.
# Vercel: YES
RAZORPAY_KEY_ID=""

# The secret shown ONCE when the key above is generated. Not recoverable —
# regenerate the pair if it is lost.
# Vercel: YES
RAZORPAY_KEY_SECRET=""

# Razorpay Dashboard -> Settings -> Webhooks -> (your webhook) -> Secret.
# This is a DIFFERENT value from RAZORPAY_KEY_SECRET above: you choose it when
# you create the webhook. Pasting the API key secret here makes every webhook
# signature check fail, so payments confirm only via the browser callback and
# silently drop whenever the customer closes the tab.
# Vercel: YES
RAZORPAY_WEBHOOK_SECRET=""


# --- Email (Resend) --------------------------------------------------------

# resend.com -> API Keys -> Create API Key (sending permission is enough).
# Starts with re_.
# Vercel: YES
RESEND_API_KEY=""

# Sender identity on every transactional email. The domain must be verified in
# Resend first. It MUST be the "Name <address>" form — a bare address is
# rejected at send time, not at boot.
#   Good: Redkido <hello@redkido.com>
#   Bad : hello@redkido.com
# Vercel: YES
EMAIL_FROM="Redkido <hello@redkido.com>"


# --- Site ------------------------------------------------------------------

# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph
# images and the Razorpay callback. Wrong here means wrong links in emails.
#   Local : http://localhost:3000
#   Vercel: https://www.redkido.com  (the production domain, not *.vercel.app)
# Vercel: YES
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# --- Seed script only ------------------------------------------------------
#
# Read exclusively by `npm run db:seed` (prisma/seed.ts) to create the admin
# login. The running app never reads them.
#
# Vercel: NO — do not add these two to the hosted project. Seed production once
# from your machine with DATABASE_URL pointed at the session pooler (5432), then
# change the password from inside the admin.

ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-before-seeding"

# Optional. Display name for the seeded admin; defaults to "Redkido Admin".
# Vercel: NO
ADMIN_NAME=""

# ---------------------------------------------------------------------------
# Google Calendar + Meet  (OPTIONAL — the app works fully without it)
#
# When set, a paid booking creates a real Calendar event with a Google Meet
# conference, and the join link goes into the confirmation email. When unset,
# fulfilment falls back to the meeting link configured in /admin/settings, and
# nothing else changes.
#
# Get the refresh token with:  node scripts/google-auth.mjs
# (see the header of that file, and DEPLOYMENT.md Step 8b)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# "primary" is the calendar of the account that authorised. Use a specific
# calendar id to keep consultations off someone's personal calendar.
GOOGLE_CALENDAR_ID="primary"
